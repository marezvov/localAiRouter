# Мастер-ключ для авторизации клиентов в шлюзе (OpenAI API Key для IDE / авто-агента)
GATEWAY_API_KEY=gw-secret-key-12345

# Списки API-ключей облачных провайдеров (через запятую, если несколько ключей на провайдер)
CEREBRAS_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
SAMBANOVA_API_KEYS=

# Опциональный исходящий прокси для доступа к внешним API (например: socks5://127.0.0.1:1080 или http://127.0.0.1:8080)
OUTBOUND_PROXY=
